                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Install deps",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/pip install -r requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "Install playwright browser",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/playwright install chromium && ${workspaceFolder}/venv/bin/playwright install-deps chromium",
            "problemMatcher": []
